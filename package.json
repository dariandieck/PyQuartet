{
  "name": "pyquartet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Top Trumps-style card game about the Python libraries behind ML pipelines",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc",
    "colors": "node scripts/colors.ts",
    "stats": "node --env-file-if-exists=.env.local scripts/stats.ts",
    "editor": "vite --config scripts/editor/vite.config.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "peerjs": "^1.5.5"
  }
}
